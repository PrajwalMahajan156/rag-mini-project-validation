# =============================================================================
# .env.example — Configuration template
# =============================================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env — it is excluded by .gitignore.
# Store production secrets in your deployment secrets manager
# (GitHub Actions Secrets, Azure Key Vault, AWS Secrets Manager, etc.)
# =============================================================================

# ---------------------------------------------------------------------------
# Required — application will refuse to start if these are absent
# ---------------------------------------------------------------------------

# Google Generative AI API key (Gemini embeddings + chat)
# Obtain from: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your-google-api-key-here

# JWT signing secret — use a long, random string (min 32 chars)
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=your-jwt-secret-here-minimum-32-characters

# ---------------------------------------------------------------------------
# Optional — Groq API (used by the AI PR reviewer workflow in CI only)
# ---------------------------------------------------------------------------

# Groq API key for AI PR review (GitHub Actions secret: GROQ_API_KEY)
# Obtain from: https://console.groq.com
# GROQ_API_KEY=your-groq-api-key-here

# ---------------------------------------------------------------------------
# Optional — Application tuning (defaults shown)
# ---------------------------------------------------------------------------

# UPLOAD_DIR=uploads
# DATA_DIR=data
# CHUNK_SIZE=1000
# CHUNK_OVERLAP=100
# EMBEDDING_MODEL=models/gemini-embedding-001
# CHAT_MODEL=gemini-2.0-flash
